      "seed": 999804035,
      "version": 1388,
      "versionNonce": 2085784195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770822575851,
      "link": null,
      "locked": false,
      "text": "用户输入\n    │\n    ▼\n┌─────────────────────────────────────────┐\n│  SimpleAgent.run(input, save=True)  │\n└─────────────────────────────────────────┘\n    │\n    ├──► input_items (会话历史)\n    │     └──► [\"user\": \"之前的问题\", \"assistant\": \"之前的回答\"]\n    │\n    ├──► context_manager.preprocess()\n    │     └──► 检查 max_turns，可能注入停止消息\n    │           └──► env.get_state() 注入环境状态\n    │\n    ├──► simple_memory 工具 (如配置)\n    │     └──► LLM 可调用读写 persistent memory\n    │\n    ▼\n┌─────────────────────────────────────────┐\n│  Agent 执行 (ReAct 循环)           │\n└─────────────────────────────────────────┘\n    │\n    ├──► TrajectoryModel (保存到数据库)\n    │     ├──► trace_id\n    │     ├──► d_input / d_output\n    │     └──► trajectories (JSON)\n    │\n    └──► ToolCacheModel (如启用缓存)\n          └──► function + args + result",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "用户输入\n    │\n    ▼\n┌─────────────────────────────────────────┐\n│  SimpleAgent.run(input, save=True)  │\n└─────────────────────────────────────────┘\n    │\n    ├──► input_items (会话历史)\n    │     └──► [\"user\": \"之前的问题\", \"assistant\": \"之前的回答\"]\n    │\n    ├──► context_manager.preprocess()\n    │     └──► 检查 max_turns，可能注入停止消息\n    │           └──► env.get_state() 注入环境状态\n    │\n    ├──► simple_memory 工具 (如配置)\n    │     └──► LLM 可调用读写 persistent memory\n    │\n    ▼\n┌─────────────────────────────────────────┐\n│  Agent 执行 (ReAct 循环)           │\n└─────────────────────────────────────────┘\n    │\n    ├──► TrajectoryModel (保存到数据库)\n    │     ├──► trace_id\n    │     ├──► d_input / d_output\n    │     └──► trajectories (JSON)\n    │\n    └──► ToolCacheModel (如启用缓存)\n          └──► function + args + result",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
