##################################################################################
# we provide basic environment variables here, see `.env.full` for full list
# 
# - for basic useage, setting llm and tools configs are enough
##################################################################################

# =============================================
# LLM
# =============================================
# setup your LLM config , ref https://api-docs.deepseek.com/
UTU_LLM_TYPE=chat.completions
# UTU_LLM_MODEL=deepseek-chat
# UTU_LLM_BASE_URL=https://api.deepseek.com/v1
# UTU_LLM_API_KEY=
# .env file
UTU_LLM_API_KEY = "be2ea5e8b122437a868326cbddd2eb8a.UP3dANdh9Ss4H5zv"
UTU_LLM_MODEL="glm-4-flash"
UTU_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# Judge LLM
JUDGE_LLM_TYPE=chat.completions
JUDGE_LLM_MODEL="glm-4-flash"
JUDGE_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
JUDGE_LLM_API_KEY="be2ea5e8b122437a868326cbddd2eb8a.UP3dANdh9Ss4H5zv"

# SERPAPI_API_KEY="77db2282c2e1e8f6d9413065450d0164dd18ec9c92b22d5652161ce9a1bbea8d"
# =============================================
# tools
# =============================================
# --- search toolkit ---
# For web search, ref https://serper.dev/playground
SERPER_API_KEY="3b1bc2dba25cef8d16bcab1c6c0c001954919f29"
# For web content extraction, ref https://jina.ai/reader
JINA_API_KEY="jina_5ed65630426841ccb45bc97451946e6d_xQ-6uXcO5Fjce01uRz3AbrwJ-38"

# =============================================
# misc (Optional) 
# =============================================
# --- E2B沙箱 --- #
# E2B API密钥，用于访问E2B沙箱服务
# 注册并获取API密钥：https://e2b.dev/docs/getting-started/api-key
E2B_API_KEY="e2b_478f552af7fa617003bb8dedc50a1ff7b330dc1a"

# --- tracing ---
# OTEL endpoint (Optional), ref https://arize.com/docs/phoenix if use Phoenix
PHOENIX_ENDPOINT=
PHOENIX_PROJECT_NAME=youtu_agent
# additional key if use Phoenix's cloud service. https://app.phoenix.arize.com/s/_space_name_/settings/general
PHOENIX_API_KEY=
# --- database ---
# database url (Optional), e.g., SQLite, PostgreSQL. DB is used to store tracing and evaluation data
UTU_DB_URL=sqlite:///test.db
# --- logging ---
UTU_LOG_LEVEL=WARNING